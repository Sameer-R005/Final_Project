  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InvestigationDialogue
  suspectNameText: {fileID: 1371356435}
  questionText: {fileID: 452234476}
  answerText: {fileID: 1535792695}
  continueText: {fileID: 1107338704}
  suspectName: Peter Menson. Married. 36 Years Old. Father to the deceased.
  answers:
  - I was upstairs taking a shower. I heard some screams. I went back again to check
    them out. It was after the party. You HAVE to find out who did this.PLEASE!!
  - 'She was my daughter, officer!! She was the light of my life. I can never do
    that to her. I would never hurt her like that. '
  - We were having this party. Everyone was here downstairs. John was in the kitchen.
    He was cooking. He got into a fight with his wife. We were drunk. He almost stabbed
    her with a bottle. I had to calm him down. I asked him to bury the dog who died
    this morning. That's it. That's all i can remember.
  nextSceneName: Invi3
