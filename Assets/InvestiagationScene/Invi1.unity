  m_Script: {fileID: 11500000, guid: b2d51fa73d3cb104994259e16aeddb2a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InvestigationDialogue
  suspectNameText: {fileID: 1116111540}
  questionText: {fileID: 1864755091}
  answerText: {fileID: 122512621}
  continueText: {fileID: 795829531}
  suspectName: 'John Vomindotur. Married. 41 Years Old. Uncle to the deceased. '
  answers:
  - 'I was burying the dog. I was out there when i saw someone with the lantern.
    I thought it was nothing. I went inside. Everyone was asleep so i went to have
    a talk with my wife. I was pretty fucked up today and the last thing i wanted
    to see today was my neice''s corpse. '
  - I was never fond of that girl. But she was my neice after all. I loved that girl.
    Never showed it but sure as hell i did.
  - 'The party was done. After the fight, i went out. To bury the dog. I heard Peter
    saying that he was going to take a shower. And Jimmy was coming inside just then.
    Everyone was in the dining room before they went to sleep. '
  nextSceneName: Invi2
