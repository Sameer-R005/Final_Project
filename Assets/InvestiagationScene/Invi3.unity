  m_Script: {fileID: 11500000, guid: b2d51fa73d3cb104994259e16aeddb2a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InvestigationDialogue
  suspectNameText: {fileID: 1851516323}
  questionText: {fileID: 285616066}
  answerText: {fileID: 293062172}
  continueText: {fileID: 1023784403}
  suspectName: Jimmy Menson. 20 Years Old. Single. Brother to the deceased.
  answers:
  - I was outside. I was on a call. Talking to my girlfriend. I was done with it
    and saw Uncle John going out. With a shovel. After an hour or so, i went out
    again. I saw my dad searching for something. We talked for a while. I went to
    sleep. Until the screams came in. I was in my room.
  - I don't know how to process this. She's the only one i had after my mom died.
    Dad was never around that much. Him and his stupid research books. Now i'm all
    alone. Without my sister.
  - I was not interested in the party. Jennie was upstairs. Everyone was in the dining
    room. I went out. Grabbed the lantern, roamed around for a bit while i was on
    the call. I was not around so i don't knnow much.
  nextSceneName: Conclusion
